# ============================================================
# Gym UES - Variables de entorno
# Copia este archivo a .env y rellena los valores.
# .env esta en .gitignore: nunca se sube al repositorio.
# ============================================================

# ---------- MongoDB Atlas (base de datos ACTUAL) ----------
# En Atlas: Database > Connect > Drivers > Node.js.
# Pega aqui la URI que te da Atlas. Formato:
#   mongodb+srv://<usuario>:<contrasena>@<cluster>.mongodb.net/gymues?retryWrites=true&w=majority
# IMPORTANTE: el nombre de la base va DENTRO de la URI, despues de la ultima
# "/". Si lo dejas fuera (mongodb+srv://.../ ), Atlas usara "test" y la
# aplicacion parecera vacia aunque los datos esten cargados.
# OJO: si tu contrasena tiene @ : / # u otros caracteres especiales,
# codificalos (%40 %3A %2F %23) o la conexion fallara.
MONGODB_URI=

# Ajustes del pool de conexiones (opcionales, rarely hay que tocarlos).
# Atlas corta las conexiones ociosas: por eso minPoolSize > 0 mantiene viva
# al menos una conexion y las peticiones siguen siendo rapidas.
MONGO_MIN_POOL=2
MONGO_MAX_POOL=20

# Duracion de la cache en memoria de la configuracion institucional (ms).
AJUSTES_CACHE_MS=60000
# Duracion de la cache del conteo de asistencias del dia (ms).
CONTEO_CACHE_MS=5000

# ---------- Servidor ----------
# En Render NO hay que fijar PORT: Render lo inyecta solo y el servidor lo
# respeta. Solo defínelo si ejecutas todo en tu maquina.
PORT=3001
# URL publica del backend. En desarrollo web dejalo vacio (mismo origen).
# En Electron se usa http://localhost:3001. En produccion pon el dominio:
# PUBLIC_URL=https://gym-ues.onrender.com
PUBLIC_URL=

# Clave secreta para restablecer contrasenas y crear admins de prueba.
# En produccion USA UNA DISTINTA a esta de ejemplo (en Render se genera
# sola con generateValue: true en render.yaml).
ADMIN_SECRET_KEY=gymues-2026

# 'development' o 'production' (en produccion se cachean los assets).
NODE_ENV=development

# ---------- Archivos ----------
# NO hay ninguna variable de carpeta de archivos: las fotos de los alumnos, los
# certificados medicos y los PDFs de reglamento/horarios se guardan DENTRO de
# Atlas (GridFS) y se sirven en /api/archivos/<id>/<nombre>. Nada se escribe en
# disco, por eso la app funciona igual en un servidor con disco efimero.

# ---------- MySQL / XAMPP (SOLO para el script de migracion) ----------
# El sistema ya corre sobre MongoDB. Estas variables las usa unicamente
# `npm run migrar`, que lee los datos viejos de XAMPP y los copia a Atlas.
# Puedes borrarlas cuando la migracion termine.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gym_ues_db
